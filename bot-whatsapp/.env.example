# Copiá este archivo a ".env" y completá los valores.

# A dónde le reporta el bot (la app de Control de Caja).
APP_URL=http://localhost:3000

# Token compartido con la app. Poné el MISMO valor en la variable BOT_TOKEN
# de la app (.env.local del proyecto). Si lo dejás vacío en los dos lados,
# funciona igual pero sin protección (sólo para desarrollo en la misma PC).
BOT_TOKEN=

# Clave de la API de Anthropic (la IA que interpreta los mensajes).
ANTHROPIC_API_KEY=

# Modelo a usar. Haiku alcanza de sobra para extraer monto + categoría.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Cada cuántos ms el bot revisa la cola de mensajes por mandar.
INTERVALO_COMANDOS_MS=8000

# Umbral de confianza de la IA: por debajo de esto, la conversación se
# escala en vez de anotar un movimiento con datos dudosos.
CONFIANZA_MINIMA=0.6
